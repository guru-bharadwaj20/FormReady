{
  "$schema": "../schema.json",
  "id": "india-evisa/tourist",
  "portal": "India e-Visa",
  "portalFullName": "Indian Visa Online (Bureau of Immigration)",
  "form": "e-Tourist Visa",
  "country": "IN",
  "category": "visa",
  "aliases": ["india evisa", "e visa india", "indian visa online", "etv"],
