{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guru-bharadwaj20/FormReady/specs/schema.json",
  "title": "FormReady portal specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "portal",
    "portalFullName",
    "form",
    "country",
    "category",
    "aliases",
    "sourceUrl",
    "lastVerified",
    "assets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "portal": { "type": "string", "minLength": 1, "maxLength": 40 },
    "portalFullName": { "type": "string", "minLength": 1 },
    "form": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "category": {
      "enum": ["exam", "government", "banking", "visa", "education", "other"]
    },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "lastVerified": { "type": "string", "format": "date" },
    "season": { "type": "string" },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "formats", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["photo", "signature", "document", "thumb", "other"] },
        "label": { "type": "string", "minLength": 1 },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["jpeg", "png", "pdf"] }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBytes"],
          "properties": {
            "minBytes": { "type": "integer", "minimum": 0 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "pixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "tolerance": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthMm", "heightMm", "dpi"],
          "properties": {
            "widthMm": { "type": "number", "exclusiveMinimum": 0 },
            "heightMm": { "type": "number", "exclusiveMinimum": 0 },
            "dpi": { "type": "integer", "minimum": 50, "maximum": 1200 }
          }
        },
        "aspect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ratio"],
          "properties": {
            "ratio": { "type": "number", "exclusiveMinimum": 0 },
            "tolerance": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "dpi": { "type": "integer", "minimum": 50, "maximum": 1200 },
        "colour": { "enum": ["colour", "greyscale", "any"] },
        "face": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minHeightFraction", "maxHeightFraction"],
          "properties": {
            "minHeightFraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxHeightFraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["light", "white", "any"] } }
        },
        "pdf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxPages": { "type": "integer", "minimum": 1 },
            "minPages": { "type": "integer", "minimum": 1 },
            "pageSize": { "enum": ["A4", "Letter", "any"] }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
